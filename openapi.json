{
  "openapi": "3.0.3",
  "info": {
    "title": "Manage Site Company Dashboard API",
    "version": "1.0.0",
    "description": "Company dashboard APIs for departments, employees, roles, activities, devices, projects, documents, and permissions."
  },
  "servers": [
    { "url": "http://127.0.0.1:8001" }
  ],
  "paths": {
    "/api/overview": {
      "get": {
        "summary": "Return the complete dashboard overview payload",
        "responses": { "200": { "description": "Dashboard overview" } }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Return company statistic summary",
        "responses": { "200": { "description": "Statistics" } }
      }
    },
    "/api/departments": {
      "get": {
        "summary": "Return departments",
        "responses": { "200": { "description": "Departments" } }
      }
    },
    "/api/roles": {
      "get": {
        "summary": "Return roles",
        "responses": { "200": { "description": "Roles" } }
      }
    },
    "/api/employees": {
      "get": {
        "summary": "Return employees, optionally filtered by role query",
        "parameters": [
          { "name": "role", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Employees" } }
      }
    },
    "/api/activity": {
      "get": {
        "summary": "Return recent activity entries",
        "responses": { "200": { "description": "Activity feed" } }
      }
    },
    "/api/devices": {
      "get": {
        "summary": "Return device inventory records",
        "responses": { "200": { "description": "Devices" } }
      }
    },
    "/api/projects": {
      "get": {
        "summary": "Return project management records",
        "responses": { "200": { "description": "Projects" } }
      }
    },
    "/api/documents": {
      "get": {
        "summary": "Return document and file access records",
        "responses": { "200": { "description": "Documents" } }
      }
    },
    "/api/permissions": {
      "get": {
        "summary": "Return access permission grant records",
        "responses": { "200": { "description": "Permissions" } }
      }
    },
    "/api/salaries": {
      "get": {
        "summary": "Return employee salary and payroll records",
        "responses": { "200": { "description": "Salaries" } }
      }
    },
    "/api/benefits": {
      "get": {
        "summary": "Return employee benefits and enrollment records",
        "responses": { "200": { "description": "Benefits" } }
      }
    },
    "/api/leave-requests": {
      "get": {
        "summary": "Return employee leave and absences records",
        "responses": { "200": { "description": "Leave requests" } }
      }
    },
    "/api/timekeeping": {
      "get": {
        "summary": "Return employee timekeeping and attendance records",
        "responses": { "200": { "description": "Timekeeping" } }
      }
    },
    "/api/accounts": {
      "get": {
        "summary": "Return created accounts for employees and administrators",
        "responses": { "200": { "description": "Accounts" } }
      },
      "post": {
        "summary": "Create an employee or admin account",
        "responses": { "201": { "description": "Account created" } }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Authenticate an employee or admin account",
        "responses": { "200": { "description": "Login response" } }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Return the current employee profile by email query",
        "parameters": [
          { "name": "email", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Employee profile" } }
      }
    },
    "/api/leave-requests/register": {
      "post": {
        "summary": "Register an employee leave request",
        "responses": { "201": { "description": "Leave registered" } }
      }
    },
    "/api/leave-requests/approve": {
      "post": {
        "summary": "Approve or update an employee leave request",
        "responses": { "200": { "description": "Leave approval response" } }
      },
      "patch": {
        "summary": "Approve or update an employee leave request",
        "responses": { "200": { "description": "Leave approval response" } }
      }
    },
    "/api/employee-capacity": {
      "get": {
        "summary": "Return employee capacity and task/leave load scoring",
        "responses": { "200": { "description": "Employee capacity rows" } }
      }
    },
    "/api/capacity": {
      "get": {
        "summary": "Alias for employee capacity scoring",
        "responses": { "200": { "description": "Employee capacity rows" } }
      }
    },
    "/api/tasks": {
      "get": {
        "summary": "Return task and document update records",
        "responses": { "200": { "description": "Tasks" } }
      }
    },
    "/api/tasks/update": {
      "post": {
        "summary": "Update a task or associated document metadata",
        "responses": { "200": { "description": "Task updated" } }
      }
    }
  }
}
