ALLOWED_ORIGIN=http://127.0.0.1:8000
ALLOWED_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
JWT_SECRET_FILE=/run/secrets/jwt_secret
HTTPS_OR_TLS=true
CONTENT_SECURITY_POLICY=default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';
DB_DSN=postgresql://app_user:app_password@db-prod:5432/companyhub
